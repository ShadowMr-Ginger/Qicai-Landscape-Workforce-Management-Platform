.driver-list-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.filter-bar {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.manage-btn {
  font-size: 28rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.search-inline {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  background: #16a34a;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.filter-picker {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #374151;
}

.reset-btn {
  margin-left: auto;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.status-toggle {
  font-size: 26rpx;
  color: #16a34a;
  background: #dcfce7;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.driver-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.driver-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.driver-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.driver-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.driver-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.tag.gender {
  color: #2563eb;
  background: #dbeafe;
}

.tag.status.on {
  color: #16a34a;
  background: #dcfce7;
}

.tag.status.off {
  color: #6b7280;
  background: #f3f4f6;
}

.driver-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  gap: 12rpx;
  font-size: 26rpx;
}

.info-label {
  color: #9ca3af;
}

.info-value {
  color: #1f2937;
  font-weight: 500;
}

.driver-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 20rpx;
}

.action-btn {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.action-btn.edit {
  color: #2563eb;
  background: #dbeafe;
}

.action-btn.restore {
  color: #16a34a;
  background: #dcfce7;
}

.action-btn.resign {
  color: #ea580c;
  background: #ffedd5;
}

.action-btn.reset {
  color: #9333ea;
  background: #f3e8ff;
}

.action-btn.delete {
  color: #dc2626;
  background: #fee2e2;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 163, 74, 0.35);
  z-index: 100;
}
