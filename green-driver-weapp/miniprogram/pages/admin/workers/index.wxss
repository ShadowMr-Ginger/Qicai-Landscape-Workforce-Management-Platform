.workers-entry-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.entry-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.entry-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.entry-desc {
  font-size: 26rpx;
  color: #9ca3af;
}
