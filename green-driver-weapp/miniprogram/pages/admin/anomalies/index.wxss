.anomalies-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.check-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.check-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.check-count {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 500;
}

.anomaly-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.anomaly-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.anomaly-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.anomaly-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.type-1 {
  color: #7c3aed;
  background: #ede9fe;
}

.type-2 {
  color: #ea580c;
  background: #ffedd5;
}

.type-3 {
  color: #dc2626;
  background: #fee2e2;
}

.subtype {
  color: #2563eb;
  background: #dbeafe;
}

.anomaly-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.anomaly-status.unresolved {
  color: #dc2626;
  background: #fee2e2;
}

.anomaly-status.resolved {
  color: #16a34a;
  background: #dcfce7;
}

.anomaly-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.anomaly-desc {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.anomaly-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #16a34a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #4b5563;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
